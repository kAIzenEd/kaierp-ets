<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[@title='Search Messages']" position="before">
            <button type="button"
                    class="btn btn-link text-action kaierp-chatter-collapse px-1"
                    title="Hide messages"
                    aria-label="Hide messages"
                    t-on-click="kaierpCollapseChatter">
                <i class="fa fa-chevron-right" role="img"/>
            </button>
        </xpath>
    </t>

</templates>
