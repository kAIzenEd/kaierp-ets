<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_student_delete_wizard_form" model="ir.ui.view">
        <field name="name">school.delete.student.wizard.form</field>
        <field name="model">school.delete.student.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Student">
                <field name="student_ids" invisible="1"/>
                <field name="student_count" invisible="1"/>
                <div class="o_row mb-3">
                    <field name="message" nolabel="1" readonly="1"
                             class="o_text_overflow" force_save="1"/>
                </div>
                <footer>
                    <button name="action_confirm_delete" type="object"
                            string="Yes" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_student_delete_wizard" model="ir.actions.act_window">
        <field name="name">Delete Student</field>
        <field name="res_model">school.delete.student.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
