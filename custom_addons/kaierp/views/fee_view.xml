<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_fee_list" model="ir.ui.view">
        <field name="name">school.fee.list</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <list string="Fees"
                  decoration-danger="state == 'overdue'"
                  decoration-success="state == 'paid'">
                <field name="student_number" string="Student ID"/>
                <field name="student_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount_due"/>
                <field name="amount_paid"/>
                <field name="amount_balance"/>
                <field name="academic_year"/>
                <field name="semester"/>
                <field name="due_date"/>
                <field name="payment_date" optional="show"/>
                <field name="invoice_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state in ('partial', 'invoiced')"
                       decoration-danger="state == 'overdue'"
                       decoration-info="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_school_fee_search" model="ir.ui.view">
        <field name="name">school.fee.search</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <search string="Fees">
                <field name="student_number" string="Student ID"/>
                <field name="student_id"/>
                <field name="product_id"/>
                <field name="academic_year"/>
                <field name="semester"/>
                <field name="name"/>
                <separator/>
                <filter string="Pending" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Partial" name="filter_partial" domain="[('state', '=', 'partial')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Overdue" name="filter_overdue" domain="[('state', '=', 'overdue')]"/>
                <filter string="Waived" name="filter_waived" domain="[('state', '=', 'waived')]"/>
                <separator/>
                <filter string="Outstanding" name="filter_outstanding"
                        domain="[('state', 'not in', ['paid', 'waived'])]"/>
                <filter string="Historical (Paid / Waived)" name="filter_historical"
                        domain="[('state', 'in', ['paid', 'waived'])]"/>
                <separator/>
                <filter string="Summer" name="filter_summer" domain="[('semester', '=', 'summer')]"/>
                <filter string="Fall" name="filter_fall" domain="[('semester', '=', 'fall')]"/>
                <filter string="Spring" name="filter_spring" domain="[('semester', '=', 'spring')]"/>
                <separator/>
                <filter string="Has Balance" name="filter_has_balance"
                        domain="[('amount_balance', '>', 0)]"/>
                <group>
                    <filter string="Student" name="groupby_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Student ID" name="groupby_student_number" context="{'group_by': 'student_number'}"/>
                    <filter string="Fee Product" name="groupby_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Academic Year" name="groupby_year" context="{'group_by': 'academic_year'}"/>
                    <filter string="Semester" name="groupby_semester" context="{'group_by': 'semester'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_school_fee_form" model="ir.ui.view">
        <field name="name">school.fee.form</field>
        <field name="model">school.fee</field>
        <field name="arch" type="xml">
            <form string="Fee">
                <header>
                    <button name="action_create_invoice" string="Create Invoice" type="object"
                            invisible="invoice_id" class="btn-primary"
                            groups="kaierp.group_school_finance,kaierp.group_school_secretary,kaierp.group_school_manager"/>
                    <button name="action_view_invoice" string="View Invoice" type="object"
                            invisible="not invoice_id" class="btn-secondary"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            invisible="state == 'paid'" class="btn-success"
                            groups="kaierp.group_school_finance,kaierp.group_school_secretary,kaierp.group_school_manager"/>
                    <button name="action_waive" string="Waive Fee" type="object"
                            invisible="state in ('paid','waived')" class="btn-secondary"
                            groups="kaierp.group_school_finance,kaierp.group_school_secretary,kaierp.group_school_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,invoiced,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_number" string="Student ID"/>
                            <field name="student_id"/>
                            <field name="admission_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="billing_unit"/>
                            <field name="is_refundable"/>
                            <field name="academic_year"/>
                            <field name="semester"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount_due" readonly="1"/>
                            <field name="amount_paid"/>
                            <field name="amount_balance" readonly="1"/>
                            <field name="due_date"/>
                            <field name="payment_date"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_fee" model="ir.actions.act_window">
        <field name="name">Pending Fees</field>
        <field name="res_model">school.fee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'not in', ['paid', 'waived'])]</field>
        <field name="search_view_id" ref="view_school_fee_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No outstanding fee assignments.
            </p>
            <p>
                Only unpaid / partial / overdue fees appear here.
                Open <strong>All Fees</strong> for the full ledger including paid history.
            </p>
        </field>
    </record>

    <record id="action_school_fee_all" model="ir.actions.act_window">
        <field name="name">All Fees</field>
        <field name="res_model">school.fee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="view_school_fee_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No student fees yet.
            </p>
            <p>
                Full fee ledger: pending, partial, paid, and waived — including
                historical ACAWEB imports. Use filters for Paid / Historical /
                Academic Year.
            </p>
        </field>
    </record>

    <record id="action_school_fee_create_combined_invoice" model="ir.actions.server">
        <field name="name">Create Combined Invoice</field>
        <field name="model_id" ref="model_school_fee"/>
        <field name="binding_model_id" ref="model_school_fee"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_invoice()</field>
    </record>

    <record id="action_ets_fee_products" model="ir.actions.act_window">
        <field name="name">ETS Fee Catalog</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_ets_fee', '=', True)]</field>
        <field name="context">{'default_is_ets_fee': True, 'default_type': 'service', 'default_sale_ok': True}</field>
    </record>
</odoo>
