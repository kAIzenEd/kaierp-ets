<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_kaierp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kaierp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="kAI-ERP" string="kAI-ERP" name="kaierp" groups="kaierp.group_school_manager,kaierp.group_school_it_admin">
                    <block title="Admissions" name="kaierp_admissions">
                        <setting string="Registrar notification email"
                                 help="An email is sent to this address whenever a new admission application is created (website or manual).">
                            <field name="admission_registrar_email" placeholder="registrar@example.org"/>
                        </setting>
                        <setting string="Document upload link validity"
                                 help="When staff request applicant response for document issues, a secure public upload link is emailed. This sets how many days the link stays valid.">
                            <field name="document_upload_token_days"/>
                        </setting>
                    </block>
                    <block title="Website Integration" name="kaierp_website_integration">
                        <setting string="Admission webhook secret"
                                 help="Use this value as ODOO_WEBHOOK_SECRET in Railway. Send it as the X-Webhook-Secret header when posting to /kaierp/api/admission/submit.">
                            <field name="admission_webhook_secret" password="True"/>
                        </setting>
                        <div class="text-muted mt-2">
                            <p><strong>API key alternative:</strong> click your avatar (top-right) →
                            <em>My Profile</em> → <em>Security</em> tab → <em>Add API Key</em>.
                            Use that key as <code>Authorization: Bearer …</code> in Railway.</p>
                            <p>Endpoint: <code>/kaierp/api/admission/submit</code> ·
                            Database header: <code>X-Odoo-Database: odoo_ets</code></p>
                        </div>
                    </block>
                    <block title="Razorpay (Payment Links)" name="kaierp_razorpay">
                        <setting string="API credentials"
                                 help="Same Razorpay account as your website. Used for exam accommodation payment links.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="razorpay_key_id" class="col-lg-3 o_light_label">Key ID</label>
                                    <field name="razorpay_key_id" placeholder="rzp_live_… or rzp_test_…"/>
                                </div>
                                <div class="row">
                                    <label for="razorpay_key_secret" class="col-lg-3 o_light_label">Key Secret</label>
                                    <field name="razorpay_key_secret" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="razorpay_webhook_secret" class="col-lg-3 o_light_label">Webhook Secret</label>
                                    <field name="razorpay_webhook_secret" password="True"/>
                                </div>
                                <div class="row mt16">
                                    <label for="razorpay_webhook_url" class="col-lg-3 o_light_label">Webhook URL</label>
                                    <field name="razorpay_webhook_url" readonly="1" class="oe_inline text-break"/>
                                </div>
                                <div class="text-muted mt-2">
                                    <p>In Razorpay Dashboard → <strong>Webhooks</strong>, add the URL above and subscribe to
                                    <code>payment_link.paid</code>. Paste the webhook secret here.</p>
                                    <p>Requires public HTTPS (ngrok for local dev).</p>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Canvas LMS" name="kaierp_canvas"
                           groups="kaierp.group_school_manager,kaierp.group_school_it_admin">
                        <setting string="Connection"
                                 help="Canvas is the source of terms, courses, student rosters, and teacher assignments. Fill these in, Save, then Connect.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="canvas_base_url" class="col-lg-3 o_light_label">Canvas URL</label>
                                    <field name="canvas_base_url" placeholder="https://your-school.instructure.com"/>
                                </div>
                                <div class="row">
                                    <label for="canvas_account_id" class="col-lg-3 o_light_label">Account ID</label>
                                    <field name="canvas_account_id" placeholder="1"/>
                                </div>
                                <div class="row">
                                    <label for="canvas_client_id" class="col-lg-3 o_light_label">Developer Key ID</label>
                                    <field name="canvas_client_id"/>
                                </div>
                                <div class="row">
                                    <label for="canvas_client_secret" class="col-lg-3 o_light_label">Developer Key Secret</label>
                                    <field name="canvas_client_secret" password="True"/>
                                </div>
                                <div class="row mt16">
                                    <label for="canvas_oauth_callback_url" class="col-lg-3 o_light_label">Redirect URI</label>
                                    <field name="canvas_oauth_callback_url" readonly="1" class="oe_inline text-break"/>
                                </div>
                                <div class="row">
                                    <label for="canvas_redirect_uri_override" class="col-lg-3 o_light_label">Redirect URI override</label>
                                    <field name="canvas_redirect_uri_override"
                                           placeholder="https://odoo-ets.kaizened.in/kaierp/canvas/oauth/callback"/>
                                </div>
                                <div class="row mt16">
                                    <label for="canvas_connected" class="col-lg-3 o_light_label">Connected</label>
                                    <field name="canvas_connected" readonly="1"/>
                                </div>
                                <div class="row">
                                    <label for="canvas_connected_user" class="col-lg-3 o_light_label">Connected as</label>
                                    <field name="canvas_connected_user" readonly="1"/>
                                </div>
                                <div class="row" invisible="not canvas_last_oauth_error">
                                    <label for="canvas_last_oauth_error" class="col-lg-3 o_light_label">Last OAuth error</label>
                                    <field name="canvas_last_oauth_error" readonly="1"/>
                                </div>
                                <div class="mt16 d-flex flex-wrap gap-2">
                                    <button name="action_canvas_oauth_start" type="object"
                                            string="Connect to Canvas" class="btn-primary"
                                            invisible="canvas_connected"/>
                                    <button name="action_canvas_test_connection" type="object"
                                            string="Test connection" class="btn-secondary"
                                            invisible="not canvas_connected"/>
                                    <button name="action_canvas_sync_now" type="object"
                                            string="Sync now" class="btn-primary"
                                            invisible="not canvas_connected"/>
                                    <button name="action_canvas_disconnect" type="object"
                                            string="Disconnect" class="btn-secondary"
                                            invisible="not canvas_connected"/>
                                </div>
                                <div class="text-muted mt-2">
                                    <p>Paste the Redirect URI into the Canvas API Developer Key.
                                    Authorize with the dedicated Canvas integration admin user.
                                    Nightly sync stays off until you enable it below.</p>
                                </div>
                            </div>
                        </setting>
                        <setting string="Nightly sync"
                                 help="When enabled, Odoo pulls terms, courses, student enrollments, and teacher assignments from Canvas once a day. Unmatched people are listed under Academics → Canvas LMS → Sync Issues.">
                            <field name="canvas_sync_enabled"/>
                        </setting>
                        <setting string="Include unpublished courses"
                                 help="Off: only published (available) and optionally completed courses. On: also sync unpublished shells.">
                            <field name="canvas_sync_unpublished"/>
                        </setting>
                        <setting string="Include completed courses"
                                 help="On: also sync concluded Canvas courses. Off: current/available courses only.">
                            <field name="canvas_sync_completed_courses"/>
                        </setting>
                        <div class="text-muted mt-2" invisible="not canvas_last_sync_summary">
                            <p><strong>Last sync:</strong>
                                <field name="canvas_last_sync_at" readonly="1" class="oe_inline"/>
                            </p>
                            <p><field name="canvas_last_sync_summary" readonly="1"/></p>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_kaierp_configuration" model="ir.actions.act_window">
        <field name="name">kAI-ERP Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'kaierp', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_kaierp_configuration"
              name="Settings"
              parent="menu_school_root"
              action="action_kaierp_configuration"
              sequence="99"
              groups="kaierp.group_school_manager,kaierp.group_school_it_admin"/>

</odoo>
